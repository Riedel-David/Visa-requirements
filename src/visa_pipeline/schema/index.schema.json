{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Riedel-David/Visa-requirements/schema/index.schema.json",
  "title": "Passport Index",
  "description": "Metadata for all published passports",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "disclaimer",
    "license",
    "license_url",
    "attribution",
    "passports"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "generated_at": {"type": "string"},
    "disclaimer": {"type": "string"},
    "license": {"type": "string"},
    "license_url": {"type": "string"},
    "attribution": {"type": "string"},
    "passports": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Z]{2}$"},
      "additionalProperties": {
        "type": "object",
        "required": ["file", "source_title", "source_url", "source_revision",
                     "source_timestamp", "record_count", "last_changed"],
        "additionalProperties": false,
        "properties": {
          "file": {"type": "string"},
          "source_title": {"type": "string"},
          "source_url": {"type": "string"},
          "source_revision": {"type": "string", "pattern": "^\\d+$"},
          "source_timestamp": {"type": "string"},
          "record_count": {"type": "integer", "minimum": 0},
          "last_changed": {"type": "string"}
        }
      }
    }
  }
}
